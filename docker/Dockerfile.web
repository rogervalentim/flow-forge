# syntax=docker/dockerfile:1.7

# ─────────────────────────────────────────────────────────────────────────────
# FlowForge UI — web app image (multi-stage)
#   target: development  → Vite dev server with HMR (compose `web` service)
#   target: runtime      → nginx serving the static production bundle
# ─────────────────────────────────────────────────────────────────────────────

ARG NODE_VERSION=22.20.0

# ── Stage 1: dependencies ────────────────────────────────────────────────────
FROM node:${NODE_VERSION}-alpine AS deps
WORKDIR /app

RUN apk add --no-cache libc6-compat

COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts && npm rebuild esbuild

# ── Stage 2: development (hot reload) ────────────────────────────────────────
FROM node:${NODE_VERSION}-alpine AS development
WORKDIR /app
ENV NODE_ENV=development

COPY --from=deps /app/node_modules ./node_modules
COPY . .

EXPOSE 5173
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5173"]

# ── Stage 3: build ───────────────────────────────────────────────────────────
FROM node:${NODE_VERSION}-alpine AS build
WORKDIR /app
ENV NODE_ENV=production

COPY --from=deps /app/node_modules ./node_modules
COPY . .

RUN npm run typecheck && npx vite build

# ── Stage 4: runtime (nginx, non-root) ───────────────────────────────────────
FROM nginx:1.29-alpine AS runtime

RUN rm -rf /usr/share/nginx/html/* \
  && apk add --no-cache curl

COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

# nginx:alpine ships an unprivileged `nginx` user; run the worker as it.
RUN touch /var/run/nginx.pid \
  && chown -R nginx:nginx /var/cache/nginx /var/run/nginx.pid /usr/share/nginx/html

USER nginx
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD curl -fsS http://127.0.0.1:8080/healthz || exit 1

CMD ["nginx", "-g", "daemon off;"]
