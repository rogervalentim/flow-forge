{
  "name": "flowforge-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "FlowForge UI — AI Agent & Prompt Workflow Orchestrator. Phase 2: Graph Engine, Advanced Hooks & Canvas.",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --reporter=default --reporter=junit --outputFile=reports/vitest-junit.xml",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build --output-dir storybook-static",
    "test:stories": "vitest run --config vitest.storybook.config.ts",
    "test:all": "npm run test:ci && npm run test:stories && npm run test:e2e",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "test:ci": "vitest run --reporter=default --reporter=junit --outputFile=reports/vitest-junit.xml",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-tabs": "1.2.1",
    "lucide-react": "1.79.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@storybook/addon-a11y": "10.6.8",
    "@storybook/addon-docs": "10.6.8",
    "@storybook/addon-vitest": "10.6.8",
    "@storybook/react": "10.6.8",
    "@storybook/react-vite": "10.6.8",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "^22.20.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/browser": "5.1.1",
    "@vitest/browser-playwright": "^5.1.1",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "jsdom": "27.0.0",
    "msw": "^3.0.7",
    "playwright": "1.65.1",
    "storybook": "^10.6.8",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.74.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
